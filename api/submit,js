// Vercel Serverless Function — handles the contact form submission.
// Runs at: POST /api/submit
//
// Forwards the message to FormSubmit, which emails it to the address below.
// No credentials are needed for FormSubmit itself, but if you switch to a
// provider that requires an API key (Resend, SendGrid, etc.), set it as a
// Vercel environment variable and read it via process.env — never hardcode
// a secret key in this file.

const RECIPIENT_EMAIL = 'spiliftmedia@gmail.com';

function isValidEmail(email) {
    return typeof email === 'string' && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

// very small in-memory rate limit per serverless instance (best-effort only —
// instances are short-lived and stateless, so this is a light deterrent,
// not a hard guarantee)
const recentSubmissions = new Map();
const RATE_LIMIT_WINDOW_MS = 60 * 1000;
const RATE_LIMIT_MAX = 5;

function isRateLimited(ip) {
    const now = Date.now();
    const timestamps = (recentSubmissions.get(ip) || []).filter(
        (t) => now - t < RATE_LIMIT_WINDOW_MS
    );
    timestamps.push(now);
    recentSubmissions.set(ip, timestamps);
    return timestamps.length > RATE_LIMIT_MAX;
}

module.exports = async (req, res) => {
    if (req.method !== 'POST') {
        res.status(405).json({ success: false, message: 'Method Not Allowed' });
        return;
    }

    const ip =
        (req.headers['x-forwarded-for'] || '').split(',')[0].trim() ||
        req.socket?.remoteAddress ||
        'unknown';

    if (isRateLimited(ip)) {
        res.status(429).json({
            success: false,
            message: 'Too many submissions. Please try again in a minute.'
        });
        return;
    }

    // Vercel's Node runtime parses JSON bodies automatically when the
    // request has Content-Type: application/json, but fall back to manual
    // parsing just in case req.body arrives as a raw string.
    let body = req.body;
    if (typeof body === 'string') {
        try {
            body = JSON.parse(body);
        } catch (err) {
            res.status(400).json({ success: false, message: 'Invalid JSON payload.' });
            return;
        }
    }
    body = body || {};

    const name = typeof body.Name === 'string' ? body.Name.trim().slice(0, 200) : '';
    const email = typeof body.Email === 'string' ? body.Email.trim() : '';
    const phone = typeof body.Phone === 'string' ? body.Phone.trim().slice(0, 40) : '';
    const service = typeof body.Service === 'string' ? body.Service.trim().slice(0, 100) : '';
    const message = typeof body.Message === 'string' ? body.Message.trim().slice(0, 5000) : '';

    if (!name || !isValidEmail(email) || !phone || !service) {
        res.status(400).json({
            success: false,
            message: 'Please fill in all required fields with a valid email.'
        });
        return;
    }

    const payload = {
        Name: name,
        Email: email,
        Phone: phone,
        Service: service,
        Message: message,
        _subject: 'New Website Enquiry — SPILIFT'
    };

    try {
        const response = await fetch(`https://formsubmit.co/ajax/${RECIPIENT_EMAIL}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json'
            },
            body: JSON.stringify(payload)
        });

        const data = await response.json().catch(() => null);

        if (response.ok) {
            res.status(200).json({
                success: true,
                message: 'Thank you! Your message has been sent successfully.'
            });
        } else {
            res.status(502).json({
                success: false,
                message: 'Something went wrong. Please try again or contact us directly.',
                detail: data
            });
        }
    } catch (err) {
        res.status(500).json({
            success: false,
            message: 'Something went wrong. Please try again or contact us directly.'
        });
    }
};